mixin table-tree(records, level = 1)
  each item in records
    - const prefix = Array(level + 1).join("-- ")
    tr
      td #{item.index} 
      td #{prefix}#{item.title}
      td
        img(src=item.thumbnail, width="100px" class="img-fluid img-thumbnail" alt=item.title)
      
      td 
            if item.status === 'active'
             span(class="badge badge-success") Hoạt động
            else if item.status === 'inactive'
             span(class="badge badge-secondary") Dừng hoạt động
            else
             span(class="badge badge-secondary") Không xác định
      td
                a(href=`${prefixAdmin}/product-category/edit/${item.id}` class="btn btn-sm btn-primary mr-2") Sửa
                a(href=`${prefixAdmin}/product-category/delete/${item.id}` class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc chắn muốn xóa mục này không?');") Xóa
    if item.children && item.children.length > 0
      +table-tree(item.children, level + 1)