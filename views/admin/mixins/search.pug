mixin searchMixin(searchQuery)
  form(id="form-search")
            .input-group
              input(
                  type="text"
                  name="search"
                  class="form-control"
                  placeholder="Tìm kiếm sản phẩm..."
                  value=searchQuery
              )
              .input-group-append
                button(class="btn btn-primary" type="submit") Tìm kiếm