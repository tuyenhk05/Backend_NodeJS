mixin select-tree(items, level = 1, parent_id = "")
  each item in items
    //- Tạo tiền tố thụt lề dựa trên cấp độ (Level)
    - const prefix = Array(level + 1).join("-- ")
    
    option(
      value=item.id 
      selected=(item.id === parent_id ? true : false)
    ) #{prefix}#{item.title}
    
    //- Nếu danh mục này có danh mục con (children), ta gọi lại chính mixin này (Đệ quy)
    if item.children && item.children.length > 0
      +select-tree(item.children, level + 1, parent_id)