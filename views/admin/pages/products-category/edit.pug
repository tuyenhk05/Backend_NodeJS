extends ../../layouts/default.pug
include ../../mixins/select-tree.pug
block content
  h1(class="mb-4") Chỉnh sửa danh mục sản phẩm
  form(
  action=`${prefixAdmin}/product-category/edit/${data.id}?_method=PATCH`
  method="POST" 
  enctype="multipart/form-data")
    .form-group
      label(for="name") Tên sản phẩm
      input(type="text" class="form-control" id="name" name="title" required value=data.title )
    .form-group
      label(for="description") Mô tả
      textarea(class="form-control tinymce-mce" id="description" name="description" rows="3" ) #{data.description}
    .form-group
        select(class="form-control" id="type" name="parentId" )
          option(value="") Chọn danh mục cha (nếu có)
          +select-tree(records,1,data.parentId)
    .form-group
      label(for="image") Hình ảnh
      input(type="file" class="form-control-file" id="image" name="thumbnail" accept="image/*" input-image)
      img(preview-image id="preview" src=data.thumbnail alt="Preview Image" style=" max-width: 200px; margin-top: 10px;")
    .form-group
     label(for="position") Vị trí
     input(type="number" class="form-control " value=data.position id="position" name="position"  min="1" placeholder="Tự động tăng lên")
    .form-group
      label(for="status") Trạng thái
      br
      //- Nhóm Radio Hoạt động
      div(class="form-check form-check-inline")
        input(
          type="radio"
          class="form-check-input"
          id="statusActive"
          name="status"
          value="active"
          checked=(data.status === "active")
        )
        label(for="statusActive" class="form-check-label") Hoạt động

      //- Nhóm Radio Dừng hoạt động
      div(class="form-check form-check-inline")
        input(
          type="radio"
          class="form-check-input"
          id="statusInactive"
          name="status"
          value="inactive"
          checked=(data.status === "inactive")
        )
        label(for="statusInactive" class="form-check-label") Dừng hoạt động
    button(type="submit" class="btn btn-primary") Cập nhật sản phẩm
    script(src="/tinymce/tinymce.min.js")
    script(src="/admin/js/tinymce-config.js")