extends ../../layouts/default.pug
include ../../mixins/table-tree.pug
block content
  h1(class="mb-4") Danh mục sản phẩm
   .card.mb-3
    .card-header Bộ lọc và Tìm kiếm
    .card-body
      .row
        .col-md-4.text-left
          a(href=`${prefixAdmin}/product-category/create` class="btn btn-success mt-3") Thêm danh mục sản phẩm mới +

  table(class="table table-hover table-sm" checkbox-Multi)
    thead
      tr
        th STT
        th Tên sản phẩm
        th Hình ảnh
        th Trạng thái
        th Hành động
    tbody
     if(records)
        +table-tree(records)
     else
       tr
         td(colspan="5") Không có dữ liệu

      

  
