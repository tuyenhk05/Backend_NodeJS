extends ../../layouts/default.pug
include ../../mixins/select-tree.pug
block content
  h1(class="mb-4") Tạo mới danh mục sản phẩm
  form(
  action=`${prefixAdmin}/product-category/create`
  method="POST" 
  enctype="multipart/form-data")
    .form-group
      label(for="name") Tên sản phẩm
      input(type="text" class="form-control" id="name" name="title" required)
    .form-group
      label(for="description") Mô tả
      textarea(class="form-control tinymce-mce" id="description" name="description" rows="3" )
    .form-group
        select(class="form-control" id="type" name="parentId" )
          option(value="") Chọn danh mục cha (nếu có)
          +select-tree(records)
    .form-group
      label(for="image") Hình ảnh
      input(type="file" class="form-control-file" id="image" name="thumbnail" accept="image/*" input-image)
      img(preview-image id="preview" src="#" alt="Preview Image" style="display:none; max-width: 200px; margin-top: 10px;")
    .form-group
     label(for="position") Vị trí
     input(type="number" class="form-control" id="position" name="position"  min="1" placeholder="Tự động tăng lên")
    .form-group
      label(for="status") Trạng thái
      select(class="form-control" id="status" name="status" required)
        option(value="active") Hoạt động
        option(value="inactive") Dừng hoạt động
    button(type="submit" class="btn btn-primary") Tạo sản phẩm
    script(src="/tinymce/tinymce.min.js")
    script(src="/admin/js/tinymce-config.js")