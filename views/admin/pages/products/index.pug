extends ../../layouts/default.pug
include ../../mixins/filter-status.pug
include ../../mixins/search.pug
block content
  h1(class="mb-4") Quản lý sản phẩm
  
  .card.mb-3
    .card-header Bộ lọc và Tìm kiếm
    .card-body
      .row
       .col-md-6
          +searchMixin(searchQuery)
       .col-md-6.text-right
           +filter-status(listStatus)
      .row
        .col-md-8
          form(
            action=`${prefixAdmin}/products/change-multi?_method=PATCH`
            method="POST"
            form-change-multi
            class="mt-3"
          ) 
            .d-flex.align-items-start
              .form-group
                select(name="type" class="form-control" valueData)
                  option(value="" disabled selected) -- Chọn hành động --
                  option(value="active") Hoạt động
                  option(value="inactive") Dừng hoạt động
                  option(value="delete-all") Xóa tất cả

              .form-group
                //- Input này để chứa danh sách ID
                input(
                  type="text"
                  name="ids"
                  value=""
                  class="form-control d-none"
                )

              button(type="submit" class="btn btn-primary ml-3") Áp dụng
        .col-md-4.text-right
          a(href=`${prefixAdmin}/products/create` class="btn btn-success mt-3") Thêm sản phẩm mới +

    
    

  table(class="table table-hover table-sm" checkbox-Multi)
    thead
      tr
        th 
            input(
            type="checkbox"
            id="selectAll"
            checkboxSelectAll
         )
        th STT
        th Hình ảnh
        th Tên sản phẩm
        th Giá
        th Trạng thái
        th Hành động
    tbody
      if products.length > 0
        each product, index in products
          tr 
            td 
              input(
                  type="checkbox" 
                  class="checkboxItem" 
                  name="id"
                  dataId=product.id
                  checkboxSelectItem
              )
            td #{index + 1}
            td 
              img(class="img-fluid img-thumbnail" src=product.thumbnail, alt=product.title, width="100px", height="auto")
            td #{product.title}
            td $#{product.price}
            td 
              if product.status === "active"
                button(
                    class="btn badge badge-success"
                    changeStatusButton
                    dataStatus="active"
                    dataId=product.id
                    
                
                ) Hoạt động
              else if product.status === "inactive"
                button(
                    class="btn badge badge-danger"
                     changeStatusButton
                    dataStatus="inactive"
                    dataId=product.id
                ) Dừng hoạt động
              else
                span(class="badge badge-secondary") Không xác định
            td 
              a(href=`${prefixAdmin}/products/edit/${product.id}` class="btn btn-warning btn-sm") Sửa
              button(
              class="btn btn-danger btn-sm ml-1"
              buttonDelete
              dataId=product.id
              ) Xóa
      else 
        tr
          td(colspan="6" class="text-center") Không tìm thấy sản phẩm nào

  nav(aria-label="Page navigation example")
    ul(class="pagination")
        li(class=`page-item ${currentPage === 1 ? 'disabled' : ''}`)
          button(class="page-link" paginationButton=currentPage-1) Trước

        - for(let i=1; i <= totalPages; i++)
            li( paginationButton=i class=`page-item ${i === currentPage ? 'active' : ''}`)
             button(class="page-link") #{i}

        li(class=`page-item ${currentPage === totalPages ? 'disabled' : ''}`)
            button(class="page-link" paginationButton=currentPage+1) Tiếp theo
    form(
        action=""
        method="POST"
        id="formChangeStatus"
        style="display: none;"
        dataPath=`${prefixAdmin}/products/update-status`
    )
    form(
        action=""
        method="POST"
        id="formDeleteProduct"
        style="display: none;"
        dataPath=`${prefixAdmin}/products/delete`
    )

    script(src="/admin/js/products.js")